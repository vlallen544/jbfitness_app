PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
# Generate a private DATABASE_URL using npm run setup:db. Never commit real credentials.
DATABASE_URL=postgresql://jbfitness:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/jbfitness
# Disabled by default; enables only the local CLI fixture, never customer checkout.
ENABLE_DEV_MEMBERSHIPS=false
ENABLE_DEV_WORKOUTS=false
# Optional server-only FoodData Central key. Empty keeps food-label logging available.
USDA_API_KEY=
# Meal estimates stay disabled until explicitly configured with a vision/structured-output model.
ENABLE_MEAL_AI=false
OPENAI_API_KEY=
MEAL_AI_MODEL=
# Workout planning stays disabled until content, models and pilot checks are ready.
ENABLE_WORKOUT_AI=false
WORKOUT_AI_PLANNER_MODEL=
WORKOUT_AI_REVIEW_MODEL=
# Optional: false lets a separate worker host process the same database queue.
WORKOUT_AI_WORKER_ENABLED=true
# Contextual chat and weekly summaries have a separate activation flag/model.
ENABLE_COACHING_AI=false
COACHING_AI_MODEL=
# Also requires confirmed owner rules and a real video-provider adapter.
ENABLE_SESSION_BOOKING=false
# Optional absolute private media directory; default: apps/api/private-media.
# EXERCISE_MEDIA_ROOT=/absolute/private/path
# Production requires a stable private key (32+ characters).
# MEDIA_SIGNING_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_KEY
